{
	"name": "copdash",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "copdash_db",
			"database_name": "copdash-db",
			"database_id": "3c106fd9-92fc-4fec-9c10-0dd94ed2a5ae"
		}
	]
}
